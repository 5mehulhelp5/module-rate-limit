{
    "name": "commercekings/module-rate-limit",
    "description": "Rate limiting for Magento 2 storefront endpoints, built on Magento's backpressure: an open registry of controllers and REST services, limits per endpoint in the admin, HTTP 429 and an IP blocklist.",
    "type": "magento2-module",
    "license": "MIT",
    "authors": [
        {
            "name": "CommerceKings"
        }
    ],
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "magento/framework": "^103.0.7",
        "magento/module-backend": "^102.0",
        "magento/module-config": "^101.2",
        "magento/module-store": "^101.1",
        "commercekings/module-core": "^0.1"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "CommerceKings\\RateLimit\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "archive": {
        "exclude": [
            "/Test/",
            "/.github/",
            "/.gitignore",
            "/.gitattributes"
        ]
    },
    "homepage": "https://github.com/commercekings/module-rate-limit",
    "support": {
        "issues": "https://github.com/commercekings/module-rate-limit/issues",
        "source": "https://github.com/commercekings/module-rate-limit"
    }
}
